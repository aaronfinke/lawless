{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug (CCP4-9 macOS)",
      "description": "Debug build — headers from ccp4-8.0-src, libs from CCP4-9",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
      }
    },
    {
      "name": "release",
      "displayName": "Release (CCP4-9 macOS)",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 4
    }
  ]
}
