{ echo "$as_me:$LINENO: checking for OpenMP flag of C++ compiler" >&5
echo $ECHO_N "checking for OpenMP flag of C++ compiler... $ECHO_C" >&6; }
if test "${ax_cv_cxx_openmp+set}" = set; then
  echo $ECHO_N "(cached) $ECHO_C" >&6
else
  saveCXXFLAGS=$CXXFLAGS
ax_cv_cxx_openmp=unknown
# Flags to try:  -fopenmp (gcc), -openmp (icc), -mp (SGI & PGI),
#                -xopenmp (Sun), -omp (Tru64), -qsmp=omp (AIX), none
ax_openmp_flags="-fopenmp -openmp -mp -xopenmp -omp -qsmp=omp none"
if test "x$OPENMP_CXXFLAGS" != x; then
  ax_openmp_flags="$OPENMP_CXXFLAGS $ax_openmp_flags"
