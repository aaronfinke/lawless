  :
else
  if test "x$ax_cv_cxx_openmp" != "xnone"; then
    OPENMP_CXXFLAGS=$ax_cv_cxx_openmp
  fi
   { echo "$as_me:$LINENO: WARNING: OpenMP enabled" >&5
echo "$as_me: WARNING: OpenMP enabled" >&2;}

